# Build específico para la instancia demo en Render (portfolio).
# Diferencia con frontend/Dockerfile: usa la configuración "demo" (apiUrl apunta
# al backend Render como origen distinto) en vez de la configuración de producción real.

# Stage 1: build
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx ng build --configuration production,demo

# Stage 2: runtime
FROM nginx:alpine AS runtime

COPY --from=build /app/dist/consultorio-odontologico/browser /usr/share/nginx/html

# Igual que frontend/Dockerfile: título y og:* por instancia al arrancar (ver 40-clinic-meta.sh)
COPY docker/40-clinic-meta.sh /docker-entrypoint.d/40-clinic-meta.sh
RUN mv /usr/share/nginx/html/index.html /usr/share/nginx/index.html.template \
    && chmod 755 /docker-entrypoint.d/40-clinic-meta.sh
COPY nginx.render.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
