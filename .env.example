# En el servidor: copiá este archivo a .env.prod y completá los valores reales
# (docker-compose.prod.yml, el deploy y los scripts de backup leen .env.prod).
# .env.prod está en .gitignore — nunca se commitea. Secretos nuevos por instancia.

# Contraseña del usuario root de MySQL
DB_PASSWORD=change_me

# Secreto para firmar JWT — string largo y aleatorio (mínimo 32 caracteres)
JWT_SECRET=change_me_with_a_long_random_string_at_least_32_chars

# Origen(es) permitidos por CORS — dominio real en producción
# Múltiples orígenes separados por coma: https://tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=https://tudominio.com

# Dominio para Caddy (reverse proxy + TLS automático)
DOMAIN=tudominio.com

# Credenciales del admin inicial — se crea automáticamente si no existe en la DB
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=change_me_strong_password

# GHCR image prefix para docker-compose.prod.yml
GHCR_IMAGE_PREFIX=ghcr.io/tu-usuario

# Tag de las imágenes backend/frontend. Normalmente NO va acá: lo pasa el CI en
# cada deploy (SHA del commit) y sin setear se usa :latest.
# Rollback manual a un commit anterior:
#   IMAGE_TAG=<sha> docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --no-build
# IMAGE_TAG=

# Bucket off-site de ESTA instancia para scripts/backup.sh (remote "b2" de rclone).
# Uno por cliente. Si rclone tiene el remote "b2" y esto está vacío, el backup falla.
BACKUP_B2_REMOTE=b2:consultorio-backups-<cliente>

# Sentry DSN para el backend (Spring Boot) — opcional, deshabilita error tracking si no está
SENTRY_DSN=

# Datos de la clínica — expuestos en GET /api/public/config (sin autenticación)
# Obligatorias en prod (el backend no arranca si faltan): CLINIC_NOMBRE, CLINIC_DIRECCION,
# CLINIC_TELEFONO, CLINIC_WHATSAPP, CLINIC_EMAIL. El resto es opcional (vacío = no se muestra).
CLINIC_NOMBRE=Mi Clínica
CLINIC_TAGLINE=Atención profesional y cercana
CLINIC_DIRECCION=Av. Ejemplo 1234
CLINIC_CIUDAD=Ciudad, País
CLINIC_HORARIO=Lunes a Viernes 09:00 – 18:00
CLINIC_TELEFONO=+598XXXXXXXX
# Solo dígitos, con código de país, sin "+"
CLINIC_WHATSAPP=598XXXXXXXX
# Código de país de la instancia: 598 (Uruguay) o 55 (Brasil). Opcional, default 598.
# Se usa a partir de F1 (normalización de teléfonos); hoy el backend todavía no la lee.
CLINIC_COUNTRY=598
CLINIC_EMAIL=contacto@ejemplo.com
# Cifras de la franja de estadísticas — vacías = la franja no se muestra
CLINIC_STATS_PACIENTES=
CLINIC_STATS_ANOS_EXPERIENCIA=
CLINIC_STATS_CALIFICACION=
# Texto libre para la sección "Sobre nosotros" (puede contener saltos de línea con \n)
CLINIC_NOSOTROS=

# Google Places — para mostrar reseñas en la página pública
# GOOGLE_PLACE_ID: ID del negocio en Google Maps (no es secreto, es público)
# Si no se define, la sección de reseñas no se muestra
GOOGLE_PLACE_ID=
# GOOGLE_PLACES_API_KEY: clave del servidor, NUNCA exponer al frontend
GOOGLE_PLACES_API_KEY=
