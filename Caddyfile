{$DOMAIN} {
	# Imágenes subidas (hero, servicios, tratamientos) son inmutables por URL.
	# Spring Security las sirve con `no-store`, lo que obliga a re-descargar cada vez.
	# Cacheamos en la capa de proxy (mismo criterio que el rate limiting en nginx):
	# el navegador descarga cada imagen una sola vez. Cache-busting = cambiar el nombre de archivo.
	@uploads path /api/uploads/*
	header @uploads {
		Cache-Control "public, max-age=2592000"
		-Pragma
		-Expires
	}

	# Assets estáticos del frontend (JS/CSS/fuentes/imágenes con hash en el nombre).
	# Angular les pone un hash de contenido, así que cambian de nombre en cada build:
	# se pueden cachear de forma agresiva e inmutable. Excluimos /api/* (lo maneja el bloque de arriba).
	# index.html NO entra acá (no tiene extensión listada) → siempre fresco, referencia los hashes nuevos.
	@static {
		not path /api/*
		path *.js *.css *.woff2 *.woff *.ttf *.svg *.ico *.png *.jpg *.jpeg *.webp *.gif
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy frontend:80
}

status.{$DOMAIN} {
	reverse_proxy uptime-kuma:3001
}
